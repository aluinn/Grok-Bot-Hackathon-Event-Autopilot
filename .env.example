# Copy this file to .env and fill in your own values. Never commit .env.

# --- sending/ ---
# Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
# Ghost: your site address, e.g. https://yoursite.ghost.io (no trailing slash)
GHOST_ADMIN_URL=
# Ghost: Settings > Integrations > Add custom integration > Admin API Key (looks like id:secret)
GHOST_ADMIN_API_KEY=

# Grok (xAI) — used for all copy, the one-line event intake and sponsor research. Get a key at https://console.x.ai
XAI_API_KEY=
# Optional: which Grok model to use (default grok-4-fast)
GROK_MODEL=
